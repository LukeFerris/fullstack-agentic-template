# Copy this file to terraform.tfvars and customize
#
# environment_id is auto-generated on first deploy. Each clone gets
# its own unique ID so multiple environments can coexist in the same
# AWS account. Do not commit this file.

# environment_id = ""  # Auto-generated if empty or absent

aws_region   = "us-east-1"
# project_name = ""  # Auto-derived from repo directory name if empty or absent

# Lambda configuration
# lambda_runtime     = "nodejs20.x"
# lambda_memory_size = 128
# lambda_timeout     = 10

# API Gateway
# api_stage_name = "prod"
